<view class="bar">
  <view class="slider" style="transform: translateX({{current * 100}}%);"></view>
  <view class="item {{current === 0 ? 'on' : ''}}" data-index="0" bindtap="go">首页</view>
  <view class="item {{current === 1 ? 'on' : ''}}" data-index="1" bindtap="go">日历</view>
  <view class="item {{current === 2 ? 'on' : ''}}" data-index="2" bindtap="go">记录</view>
  <view class="item {{current === 3 ? 'on' : ''}}" data-index="3" bindtap="go">我</view>
</view>
