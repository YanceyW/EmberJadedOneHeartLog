.bar {
  position: fixed;
  /* left / right / bottom 由 JS 写成同一 edgeGap，保证各机型三边等距 */
  height: 88rpx;
  display: flex;
  align-items: center;
  background: #fffaf8;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(227, 154, 168, 0.18);
  z-index: 30;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.slider {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: calc((100% - 16rpx) / 5);
  height: 72rpx;
  border-radius: 999rpx;
  background: #f8d5dc;
  transition: transform 0.28s ease;
}

.item {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a08b84;
  font-size: 28rpx;
}

.item.on {
  color: #8a3d48;
  font-weight: 600;
}

.gap {
  flex: 1;
}

.ai {
  position: absolute;
  left: 50%;
  top: -36rpx;
  width: 104rpx;
  height: 104rpx;
  margin-left: -52rpx;
  border-radius: 50%;
  background: #e9899a;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  box-shadow: 0 10rpx 24rpx rgba(233, 137, 154, 0.45);
}

.ai.on {
  transform: scale(1.04);
}
