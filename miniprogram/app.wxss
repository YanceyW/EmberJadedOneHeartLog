page {
  background: #fff7f4;
  color: #5c463f;
  font-size: 30rpx;
  line-height: 1.5;
}

.page {
  width: 100%;
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: #fffaf8;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(227, 154, 168, 0.12);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #5c463f;
}

.muted {
  color: #a08b84;
  font-size: 26rpx;
}

.btn {
  background: #e9899a;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  text-align: center;
  transition: transform 0.2s ease;
}

.btn.plain {
  background: #f8d5dc;
  color: #8a3d48;
}

.btn:active,
.entry:active {
  transform: scale(0.97);
}

input,
textarea {
  background: #fff7f4;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
  color: #5c463f;
}

@keyframes heart-pop {
  0% {
    transform: scale(0.6);
  }
  60% {
    transform: scale(1.15);
  }
  100% {
    transform: scale(1);
  }
}
