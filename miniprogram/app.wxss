page {
  background: #fff7f4;
  color: #5c463f;
  font-size: 30rpx;
  line-height: 1.5;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

.card {
  background: #fffaf8;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(227, 154, 168, 0.12);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #5c463f;
}

.muted {
  color: #a08b84;
  font-size: 26rpx;
}

.btn {
  background: #e9899a;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  text-align: center;
  transition: transform 0.2s ease;
}

.btn.plain {
  background: #f8d5dc;
  color: #8a3d48;
}

.btn.ghost {
  background: transparent;
  color: #a08b84;
}

.btn:active,
.entry:active {
  transform: scale(0.97);
}

input,
textarea {
  background: #fff7f4;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
  color: #5c463f;
}

.rise {
  animation: rise 0.32s ease both;
}

.rise.d2 {
  animation-delay: 0.06s;
}

.rise.d3 {
  animation-delay: 0.12s;
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes heart-pop {
  0% {
    transform: scale(0.6);
  }
  60% {
    transform: scale(1.15);
  }
  100% {
    transform: scale(1);
  }
}
