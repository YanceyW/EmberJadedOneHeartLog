.person {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0e6e1;
}

.chip {
  background: #f8d5dc;
  color: #8a3d48;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.chip.on {
  background: #e9899a;
  color: #fff;
}

.plain {
  margin-top: 16rpx;
}
