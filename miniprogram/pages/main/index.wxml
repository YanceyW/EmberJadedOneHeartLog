<view class="stage">
<swiper class="deck" current="{{current}}" duration="280" bindchange="onChange">
  <swiper-item class="slide"><view class="fill"><home-panel active="{{current === 0}}" bind:jumpto="onTab" bind:ask="openAsk" /></view></swiper-item>
  <swiper-item class="slide"><view class="fill"><calendar-panel active="{{current === 1}}" bind:jumpto="onTab" /></view></swiper-item>
  <swiper-item class="slide"><view class="fill"><ask-panel active="{{current === 2}}" /></view></swiper-item>
  <swiper-item class="slide"><view class="fill"><records-panel active="{{current === 3}}" bind:jumpto="onTab" /></view></swiper-item>
  <swiper-item class="slide"><view class="fill"><mine-panel active="{{current === 4}}" /></view></swiper-item>
</swiper>

<tab-bar current="{{current}}" bind:change="onTab" bind:ask="openAsk" />
</view>
