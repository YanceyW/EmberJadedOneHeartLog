:host {
  display: block;
  width: 100%;
  height: 100%;
}

.page {
  height: 100%;
  min-height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 16rpx 32rpx 0;
}

.head, .row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.head {
  justify-content: center;
}

.row {
  justify-content: flex-start;
  flex-wrap: wrap;
}

.head {
  position: relative;
  min-height: 72rpx;
  background: #fff7f4;
}

.head .title {
  font-size: 36rpx;
  font-weight: 600;
}

.filter-wrap {
  position: absolute;
  right: 0;
  top: 0;
  z-index: 16;
}

.filter-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.filter-icon .bar {
  height: 4rpx;
  border-radius: 4rpx;
  background: #e9899a;
}

.filter-icon .a { width: 36rpx; }
.filter-icon .b { width: 26rpx; }
.filter-icon .c { width: 16rpx; }

.filter-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 15;
}

.filter-pop {
  position: absolute;
  top: 76rpx;
  right: 0;
  z-index: 16;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  min-width: 220rpx;
  padding: 16rpx;
  background: #fffaf8;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(92, 70, 63, 0.16);
}

.filter-pop .chip {
  text-align: center;
}

.small {
  width: 140rpx;
  line-height: 64rpx;
}

.hint, .swipe {
  margin: 8rpx 0 16rpx;
}

.week, .grid {
  display: flex;
  flex-wrap: wrap;
}

.weekday,
.cell {
  width: 14.28%;
  text-align: center;
  box-sizing: border-box;
}

.weekday {
  color: #a08b84;
  padding-bottom: 8rpx;
}

.cell {
  min-height: 108rpx;
  padding-top: 8rpx;
}

.lunar {
  font-size: 18rpx;
  line-height: 1.2;
  color: #c47b88;
}

.daynum {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  margin: 0 auto;
  border-radius: 50%;
}

.cell.today .daynum {
  background: #f8d5dc;
  color: #5c463f;
  font-weight: 600;
}

.viewport {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.month {
  background: rgba(255, 250, 248, 0.82);
  border-radius: 28rpx;
  padding: 12rpx 8rpx 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(227, 154, 168, 0.12);
}

.upcoming {
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 28rpx;
  padding: 8rpx 20rpx 12rpx;
  border: 2rpx solid #f3d5dc;
}

.upcoming-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 4rpx 4rpx;
  color: #8a3d48;
  font-size: 40rpx;
  font-weight: 600;
}

.more-link {
  font-size: 26rpx;
  font-weight: 500;
  color: #e9899a;
}

.upcoming .item {
  padding: 18rpx 4rpx;
}

.pop {
  position: fixed;
  z-index: 85;
  width: 168px;
  background: #fffaf8;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(92, 70, 63, 0.16);
  padding: 8rpx 0;
}

.pop-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  opacity: 0;
  transform: translateY(-10rpx);
}

.pop-item.show {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.22s ease, transform 0.22s ease;
}

.pop-item.show .pop-icon {
  transform: scale(1);
}

.pop-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  transform: scale(0.5);
  transition: transform 0.22s ease;
}

.pop-icon.heart { background: #e9899a; }
.pop-icon.mark { background: #6b8f71; }
.pop-icon.bell { background: #6d8caf; }

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 19;
}

.lunar-full {
  margin-top: 8rpx;
  color: #8a3d48;
}

.almanac {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #8a7e78;
}

.day-pop {
  position: fixed;
  z-index: 85;
  width: 260px;
  overflow: auto;
  background: #fffaf8;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(92, 70, 63, 0.16);
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.arrow {
  width: 80rpx;
  text-align: center;
  font-size: 64rpx;
  font-weight: 600;
  color: #e9899a;
  line-height: 1;
}

.almanac-brief {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 250, 248, 0.82);
  border-radius: 20rpx;
  color: #8a3d48;
  font-size: 26rpx;
  line-height: 1.5;
}

.almanac-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  background: #fffaf8;
  border-radius: 32rpx 32rpx 0 0;
  padding: 12rpx 32rpx 48rpx;
  box-sizing: border-box;
  overflow: auto;
}

.grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #f3d5dc;
  margin: 8rpx auto 20rpx;
}

.brief {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f3d5dc;
  color: #5c463f;
}

.to-left {
  animation: toLeft 0.28s ease;
}

.to-right {
  animation: toRight 0.28s ease;
}

@keyframes toLeft {
  from { transform: translateX(48rpx); }
  to { transform: translateX(0); }
}

@keyframes toRight {
  from { transform: translateX(-48rpx); }
  to { transform: translateX(0); }
}

.icons {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 4rpx;
  min-height: 20rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.heart {
  width: 12rpx;
  height: 12rpx;
  background: #e9899a;
  transform: rotate(-45deg);
  position: relative;
  margin: 4rpx 4rpx 0;
}

.heart::before,
.heart::after {
  content: "";
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: #e9899a;
  border-radius: 50%;
}

.heart::before {
  top: -6rpx;
  left: 0;
}

.heart::after {
  left: 6rpx;
  top: 0;
}

.heart.predicted,
.heart.predicted::before,
.heart.predicted::after {
  background: #f3c3cb;
}

.dot.ovulation { background: #d4a017; }
.dot.fertile { background: #efd48a; }
.dot.anniversary { background: #6b8f71; }
.dot.birthday { background: #d08a3a; }
.dot.schedule { background: #6d8caf; }

.more {
  font-size: 18rpx;
  color: #8a7e78;
}

.chip {
  background: #f3e6e4;
  color: #8a3d48;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.chip.on {
  background: #e9899a;
  color: #fff;
}

.item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0e6e1;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(92, 70, 63, 0.28);
  display: flex;
  align-items: flex-end;
  z-index: 80;
  animation: maskin 0.25s ease;
}

.sheet {
  width: 100%;
  background: #fffaf8;
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 28rpx 0;
  max-height: 80vh;
  overflow: auto;
  animation: slideup 0.32s ease;
  position: relative;
  z-index: 81;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #5c463f;
  margin-bottom: 8rpx;
}

.picker {
  margin-top: 12rpx;
  background: #fff7f4;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
}

.filter-pop .pop-item.on {
  color: #e9899a;
  font-weight: 600;
}

@keyframes maskin {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideup {
  from { transform: translateY(48rpx); }
  to { transform: translateY(0); }
}

.detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.tools {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.tool {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f8d5dc;
  color: #8a3d48;
}

.tool.danger {
  background: #e9899a;
  color: #fff;
}

.sheet .btn, .sheet .label {
  margin-top: 16rpx;
}

.btn {
  background: #e9899a;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  text-align: center;
}

.date-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-line input {
  flex: 1;
}

.cal {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid #e9899a;
  border-radius: 12rpx;
  position: relative;
  flex-shrink: 0;
}

.cal::before {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 16rpx;
  bottom: 8rpx;
  border-top: 3rpx solid #e9899a;
}
