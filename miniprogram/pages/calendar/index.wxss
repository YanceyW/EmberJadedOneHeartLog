:host {
  display: block;
  width: 100%;
  height: 100%;
}

.page {
  position: relative;
  height: 100%;
  min-height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 16rpx 32rpx 0;
  overflow: hidden;
}

.head, .row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.head {
  justify-content: center;
}

.row {
  justify-content: flex-start;
  flex-wrap: wrap;
}

.month-shell {
  position: relative;
  z-index: 1;
  background: #fffaf8;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(227, 154, 168, 0.12);
  overflow: visible;
}

.head {
  position: relative;
  min-height: 72rpx;
  background: transparent;
}

.head .title {
  font-size: 36rpx;
  font-weight: 600;
}

.filter-wrap {
  position: absolute;
  right: 0;
  top: 0;
  z-index: 16;
}

.filter-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.filter-icon .bar {
  height: 4rpx;
  border-radius: 4rpx;
  background: #e9899a;
}

.filter-icon .a { width: 36rpx; }
.filter-icon .b { width: 26rpx; }
.filter-icon .c { width: 16rpx; }

.filter-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 15;
}

.filter-pop {
  position: absolute;
  top: 76rpx;
  right: 0;
  z-index: 16;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  min-width: 220rpx;
  padding: 16rpx;
  background: #fffaf8;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(92, 70, 63, 0.16);
}

.hint {
  margin: 8rpx 0 16rpx;
}

.week, .grid {
  display: flex;
  flex-wrap: wrap;
}

.weekday,
.cell {
  width: 14.28%;
  text-align: center;
  box-sizing: border-box;
}

.weekday {
  color: #a08b84;
  padding-bottom: 8rpx;
}

.cell {
  min-height: 108rpx;
  padding-top: 8rpx;
}

.lunar {
  font-size: 18rpx;
  line-height: 1.2;
  color: #c47b88;
}

.daynum {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  margin: 0 auto;
  border-radius: 50%;
}

.cell.today .daynum {
  color: #5c463f;
  font-weight: 600;
  box-shadow: inset 0 0 0 2rpx #f8d5dc;
}

.cell.selected .daynum {
  background: #f8d5dc;
  color: #5c463f;
  font-weight: 600;
  box-shadow: none;
}

.viewport {
  flex: none;
  overflow: hidden;
}

.below-sheet {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 4;
  background: #fff7f4;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -10rpx 28rpx rgba(92, 70, 63, 0.08);
  display: flex;
  flex-direction: column;
}

.grab {
  height: 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.grab::after {
  content: "";
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e7d5d2;
}

.grab-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 28rpx;
  bottom: 0;
}

.below {
  flex: 1;
  height: 0;
  min-height: 0;
}

.month {
  position: relative;
  background: transparent;
  border-radius: 0;
  padding: 12rpx 8rpx 20rpx;
  box-shadow: none;
}

.upcoming {
  position: relative;
  z-index: 1;
  margin: 28rpx 32rpx 0;
  background: #fffaf8;
  border-radius: 28rpx;
  padding: 8rpx 20rpx 12rpx;
  border: 2rpx solid #f3d5dc;
}

.upcoming-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 4rpx 4rpx;
  color: #8a3d48;
  font-size: 40rpx;
  font-weight: 600;
}

.more-link {
  font-size: 26rpx;
  font-weight: 500;
  color: #e9899a;
}

.upcoming .item {
  padding: 18rpx 4rpx;
}

.pop {
  position: fixed;
  z-index: 85;
  width: 168px;
  background: #fffaf8;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(92, 70, 63, 0.16);
  padding: 8rpx 0;
}

.pop-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  opacity: 0;
  transform: translateY(-10rpx);
}

.pop-item.show {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.22s ease, transform 0.22s ease;
}

.pop-item.show .pop-icon {
  transform: scale(1);
}

.pop-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  transform: scale(0.5);
  transition: transform 0.22s ease;
}

.pop-icon.heart { background: #e9899a; }
.pop-icon.fertile { background: #d4a017; }
.pop-icon.anniversary { background: #6b8f71; }
.pop-icon.birthday { background: #d08a3a; }
.pop-icon.bell,
.pop-icon.schedule { background: #6d8caf; }

.filter-pop .pop-icon {
  width: 16rpx;
  height: 16rpx;
  margin: 0;
  border-radius: 50%;
  flex-shrink: 0;
  line-height: 0;
}

.filter-pop .pop-icon.period {
  width: 12rpx;
  height: 12rpx;
  margin: 4rpx 6rpx 0;
  border-radius: 0;
  background: #e9899a;
  position: relative;
  transform: rotate(-45deg) scale(0.5);
}

.filter-pop .pop-item.show .pop-icon.period {
  transform: rotate(-45deg) scale(1);
}

.filter-pop .pop-icon.period::before,
.filter-pop .pop-icon.period::after {
  content: "";
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: #e9899a;
  border-radius: 50%;
}

.filter-pop .pop-icon.period::before {
  top: -6rpx;
  left: 0;
}

.filter-pop .pop-icon.period::after {
  left: 6rpx;
  top: 0;
}

.pop .pop-icon {
  width: 16rpx;
  height: 16rpx;
  margin: 0;
  border-radius: 50%;
  position: static;
  flex-shrink: 0;
  transform: scale(0.5);
}

.pop .pop-item.show .pop-icon {
  transform: scale(1);
}

.pop .pop-icon.heart::before,
.pop .pop-icon.heart::after {
  content: "";
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background: #e9899a;
  border-radius: 50%;
}

.pop .pop-icon.heart {
  width: 16rpx;
  height: 16rpx;
  margin: 4rpx 6rpx 0;
  border-radius: 0;
  background: #e9899a;
  position: relative;
  transform: rotate(-45deg) scale(0.5);
}

.pop .pop-item.show .pop-icon.heart {
  transform: rotate(-45deg) scale(1);
}

.pop .pop-icon.heart::before {
  top: -8rpx;
  left: 0;
}

.pop .pop-icon.heart::after {
  left: 8rpx;
  top: 0;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 19;
}

.yi-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 14rpx;
}

.almanac-brief {
  margin: 20rpx 32rpx 0;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(227, 154, 168, 0.12);
}

.lunar-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.lunar-hero {
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #5c463f;
}

.pillars {
  display: flex;
  gap: 18rpx;
  flex-shrink: 0;
}

.pillar {
  min-width: 36rpx;
  text-align: center;
}

.pillar-name {
  font-size: 20rpx;
  color: #a08b84;
  line-height: 1.4;
}

.pillar-char {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.25;
}

.huangli-label {
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #8a3d48;
}

.mark {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.mark.yi { background: #e9899a; }
.mark.ji { background: #8a7e78; }

.mark-text {
  flex: 1;
  color: #5c463f;
  font-size: 28rpx;
  line-height: 1.6;
  padding-top: 6rpx;
  white-space: normal;
  word-break: break-all;
}

.day-item {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f3d5dc;
}

.arrow {
  width: 80rpx;
  text-align: center;
  font-size: 64rpx;
  font-weight: 600;
  color: #e9899a;
  line-height: 1;
}


.grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #f3d5dc;
  margin: 8rpx auto 20rpx;
}

.to-left {
  animation: toLeft 0.28s ease;
}

.to-right {
  animation: toRight 0.28s ease;
}

@keyframes toLeft {
  from { transform: translateX(48rpx); }
  to { transform: translateX(0); }
}

@keyframes toRight {
  from { transform: translateX(-48rpx); }
  to { transform: translateX(0); }
}

.icons {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 4rpx;
  min-height: 20rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.heart {
  width: 12rpx;
  height: 12rpx;
  background: #e9899a;
  transform: rotate(-45deg);
  position: relative;
  margin: 4rpx 4rpx 0;
}

.heart::before,
.heart::after {
  content: "";
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: #e9899a;
  border-radius: 50%;
}

.heart::before {
  top: -6rpx;
  left: 0;
}

.heart::after {
  left: 6rpx;
  top: 0;
}

.heart.predicted,
.heart.predicted::before,
.heart.predicted::after {
  background: #f3c3cb;
}

.dot.ovulation { background: #d4a017; }
.dot.fertile { background: #efd48a; }
.dot.anniversary { background: #6b8f71; }
.dot.birthday { background: #d08a3a; }
.dot.schedule { background: #6d8caf; }

.more {
  font-size: 18rpx;
  color: #8a7e78;
}

.item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0e6e1;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(92, 70, 63, 0.28);
  display: flex;
  align-items: flex-end;
  z-index: 80;
  animation: maskin 0.25s ease;
}

.sheet {
  width: 100%;
  background: #fffaf8;
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 28rpx 0;
  max-height: 80vh;
  overflow: auto;
  animation: slideup 0.32s ease;
  position: relative;
  z-index: 81;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #5c463f;
  margin-bottom: 8rpx;
}

.filter-pop .pop-item.on {
  color: #e9899a;
  font-weight: 600;
}

@keyframes maskin {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideup {
  from { transform: translateY(48rpx); }
  to { transform: translateY(0); }
}

.detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.tools {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.tool {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f8d5dc;
  color: #8a3d48;
}

.tool.danger {
  background: #e9899a;
  color: #fff;
}

.muted {
  color: #a08b84;
  font-size: 26rpx;
}

.sheet .label {
  margin-top: 32rpx;
  color: #a08b84;
  font-size: 26rpx;
}

.sheet .field {
  display: block;
  flex: 1;
  width: 100%;
  min-width: 0;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  margin-top: 32rpx;
  padding: 0 24rpx;
  background: #fff7f4;
  border-radius: 20rpx;
  color: #5c463f;
  font-size: 30rpx;
  box-sizing: border-box;
}

.sheet .date-line {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.sheet .date-line .field {
  width: auto;
  margin-top: 0;
}

.sheet .row {
  margin-top: 20rpx;
  gap: 20rpx;
}

.sheet .chip {
  background: #f3e6e4;
  color: #8a3d48;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
}

.sheet .chip.on {
  background: #e9899a;
  color: #fff;
}

.sheet .picker {
  margin-top: 16rpx;
  background: #fff7f4;
  border-radius: 20rpx;
  padding: 24rpx;
  color: #5c463f;
}

.sheet .btn {
  margin-top: 40rpx;
  background: #e9899a;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  text-align: center;
}

.sheet .btn:active {
  transform: scale(0.97);
}

.sheet .cal {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid #e9899a;
  border-radius: 12rpx;
  position: relative;
  flex-shrink: 0;
}

.sheet .cal::before {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 16rpx;
  bottom: 8rpx;
  border-top: 3rpx solid #e9899a;
}

/* ---------- 法定节假日 ---------- */
.cell {
  position: relative;
}

.badge {
  position: absolute;
  right: 6rpx;
  top: 4rpx;
  width: 26rpx;
  height: 26rpx;
  line-height: 26rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  text-align: center;
  color: #ffffff;
  background: #e9899a;
}

.badge.work {
  background: #9aa7b8;
}

.lunar.has-festival {
  color: #b8566a;
  font-weight: 600;
}

.holiday-tip {
  color: #b8566a;
}

.holiday-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #b8566a;
  line-height: 1.5;
}