.label {
  margin-top: 20rpx;
}

.row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  background: #f8d5dc;
  color: #8a3d48;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.chip.on {
  background: #e9899a;
  color: #fff;
}

.save {
  margin-top: 24rpx;
}

.picker {
  margin-top: 12rpx;
  background: #fff7f4;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
}
