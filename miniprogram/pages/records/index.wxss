:host {
  display: block;
  width: 100%;
  height: 100%;
}

.records-head {
  position: sticky;
  top: 0;
  z-index: 8;
  background: #fff7f4;
  padding-bottom: 8rpx;
}

.page {
  width: 100%;
  height: 100%;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 16rpx 32rpx 0;
}

.card {
  position: relative;
  z-index: 1;
  background: #fffaf8;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.group-title {
  margin: 28rpx 8rpx 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #5c463f;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #5c463f;
}

.kind,
.muted {
  color: #a08b84;
  font-size: 26rpx;
}

.row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.chip {
  background: #f8d5dc;
  color: #8a3d48;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.chip.on {
  background: #e9899a;
  color: #fff;
}

.empty {
  margin: 12rpx 8rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(92, 70, 63, 0.28);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fffaf8;
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 28rpx 0;
  box-sizing: border-box;
}

.sheet .detail-head,
.sheet .date-line {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.sheet .detail-head {
  justify-content: space-between;
}

.sheet .section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #5c463f;
}

.sheet .label {
  margin-top: 32rpx;
  color: #a08b84;
  font-size: 26rpx;
}

.sheet .field {
  display: block;
  flex: 1;
  width: 100%;
  min-width: 0;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  margin-top: 32rpx;
  padding: 0 24rpx;
  background: #fff7f4;
  border-radius: 20rpx;
  color: #5c463f;
  font-size: 30rpx;
  box-sizing: border-box;
}

.sheet .date-line {
  margin-top: 16rpx;
}

.sheet .date-line .field {
  width: auto;
  margin-top: 0;
}

.sheet .row {
  margin-top: 20rpx;
  margin-bottom: 0;
  gap: 20rpx;
}

.sheet .chip {
  padding: 16rpx 28rpx;
}

.sheet .picker {
  margin-top: 16rpx;
  background: #fff7f4;
  border-radius: 20rpx;
  padding: 24rpx;
  color: #5c463f;
}

.sheet .tool.danger {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #e9899a;
  color: #fff;
  flex-shrink: 0;
}

.sheet .btn {
  margin-top: 40rpx;
  background: #e9899a;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  text-align: center;
}

.sheet .btn:active {
  transform: scale(0.97);
}

.sheet .cal {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid #e9899a;
  border-radius: 12rpx;
  position: relative;
  flex-shrink: 0;
}

.sheet .cal::before {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 16rpx;
  bottom: 8rpx;
  border-top: 3rpx solid #e9899a;
}

.head-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 16rpx;
}

.head-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #5c463f;
}

.head-tools {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.head-tool {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #f8d5dc;
  color: #8a3d48;
  font-size: 28rpx;
}

.head-tool.add {
  width: 64rpx;
  padding: 0;
  text-align: center;
  font-size: 40rpx;
  background: #e9899a;
  color: #fff;
}

.item.picked {
  background: #fdeff2;
  box-shadow: inset 0 0 0 3rpx #e9899a;
}

.pick-dot {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #e9899a;
  color: #fff;
  text-align: center;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.item.picked .pick-dot {
  background: #e9899a;
}

.empty-add {
  margin-top: 8rpx;
  display: inline-block;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  background: #e9899a;
  color: #fff;
  font-size: 28rpx;
}

.add-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(92, 70, 63, 0.28);
}

.add-pop {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 81;
  background: #fffaf8;
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 28rpx 0;
  box-sizing: border-box;
  box-shadow: 0 -12rpx 36rpx rgba(227, 154, 168, 0.18);
}

.add-scroll {
  max-height: 46vh;
}

.add-title {
  font-size: 26rpx;
  color: #a08b84;
  padding: 0 8rpx 12rpx;
}

.add-item {
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  color: #5c463f;
}

.add-item:active {
  background: #fdeff2;
}

.manage-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  z-index: 12;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fffaf8;
  border-radius: 999rpx;
  padding: 16rpx 20rpx 16rpx 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(227, 154, 168, 0.24);
}

.manage-del {
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  background: #e9899a;
  color: #fff;
  font-size: 28rpx;
}
.section-cap {
  margin: 24rpx 8rpx 12rpx;
  font-size: 26rpx;
  color: #a08b84;
}

.decision {
  padding: 24rpx 28rpx;
}

.dec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.dec-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #5c463f;
}

.dec-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8a3d48;
  background: #f8d5dc;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.dec-opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background: #fff7f4;
  font-size: 30rpx;
  color: #5c463f;
}

.dec-opt.mine {
  box-shadow: inset 0 0 0 3rpx #e9899a;
}

.dec-opt.win {
  background: #fdeff2;
  color: #8a3d48;
  font-weight: 600;
}

.dec-count {
  font-size: 26rpx;
  color: #a08b84;
}

.dec-result {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #8a3d48;
}

.dec-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.dec-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #e9899a;
  color: #fff;
  font-size: 26rpx;
}

.dec-btn.ghost {
  background: #f8d5dc;
  color: #8a3d48;
}

.opt-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.opt-line .field {
  margin-top: 0;
}

.opt-del {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f8d5dc;
  color: #8a3d48;
  font-size: 36rpx;
  flex-shrink: 0;
}

.add-opt {
  margin-top: 16rpx;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 20rpx;
  border: 2rpx dashed #e9899a;
  color: #8a3d48;
  font-size: 28rpx;
}
.decision-block {
  display: block;
}

.dec-opt-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}