:host {
  display: block;
  width: 100%;
  height: 100%;
}

.records-head {
  position: sticky;
  top: 0;
  z-index: 8;
  background: #fff7f4;
  padding-bottom: 8rpx;
}

.page {
  width: 100%;
  height: 100%;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 16rpx 32rpx 0;
}

.card {
  position: relative;
  z-index: 1;
  background: #fffaf8;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.group-title {
  margin: 28rpx 8rpx 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #5c463f;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #5c463f;
}

.kind,
.muted {
  color: #a08b84;
  font-size: 26rpx;
}

.row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.chip {
  background: #f8d5dc;
  color: #8a3d48;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.chip.on {
  background: #e9899a;
  color: #fff;
}

.empty {
  margin: 12rpx 8rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(92, 70, 63, 0.28);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fffaf8;
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 28rpx 0;
  box-sizing: border-box;
}

.sheet .detail-head,
.sheet .date-line {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.sheet .detail-head {
  justify-content: space-between;
}

.sheet .section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #5c463f;
}

.sheet .label {
  margin-top: 32rpx;
  color: #a08b84;
  font-size: 26rpx;
}

.sheet .field {
  display: block;
  flex: 1;
  width: 100%;
  min-width: 0;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  margin-top: 32rpx;
  padding: 0 24rpx;
  background: #fff7f4;
  border-radius: 20rpx;
  color: #5c463f;
  font-size: 30rpx;
  box-sizing: border-box;
}

.sheet .date-line {
  margin-top: 16rpx;
}

.sheet .date-line .field {
  width: auto;
  margin-top: 0;
}

.sheet .row {
  margin-top: 20rpx;
  margin-bottom: 0;
  gap: 20rpx;
}

.sheet .chip {
  padding: 16rpx 28rpx;
}

.sheet .picker {
  margin-top: 16rpx;
  background: #fff7f4;
  border-radius: 20rpx;
  padding: 24rpx;
  color: #5c463f;
}

.sheet .tool.danger {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #e9899a;
  color: #fff;
  flex-shrink: 0;
}

.sheet .btn {
  margin-top: 40rpx;
  background: #e9899a;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  text-align: center;
}

.sheet .btn:active {
  transform: scale(0.97);
}

.sheet .cal {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid #e9899a;
  border-radius: 12rpx;
  position: relative;
  flex-shrink: 0;
}

.sheet .cal::before {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 16rpx;
  bottom: 8rpx;
  border-top: 3rpx solid #e9899a;
}
