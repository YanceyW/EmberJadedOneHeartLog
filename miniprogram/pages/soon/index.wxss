.soon {
  padding-top: 180rpx;
  text-align: center;
}

.mini-heart {
  width: 28rpx;
  height: 28rpx;
  margin: 0 auto 24rpx;
  background: #e9899a;
  position: relative;
  transform: rotate(-45deg);
  animation: heart-pop 0.35s ease;
}

.mini-heart::before,
.mini-heart::after {
  content: "";
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  background: #e9899a;
  border-radius: 50%;
}

.mini-heart::before {
  top: -14rpx;
  left: 0;
}

.mini-heart::after {
  left: 14rpx;
  top: 0;
}
