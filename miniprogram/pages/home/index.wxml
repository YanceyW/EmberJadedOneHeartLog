<scroll-view class="page" scroll-y bindscroll="onPageScroll">
  <view class="hello card">
    <view class="mini-heart"></view>
    <view>
      <view class="title">{{hello}}</view>
      <view class="muted">{{todayLine}}</view>
      <view class="muted">今天也要好好照顾彼此</view>
    </view>
  </view>

  <view class="card weather-card {{skyOn ? 'sky-on' : 'no-sky'}} {{skyBroken ? 'sky-broken' : ''}} {{skyDark ? 'is-dark' : ''}}" style="{{skyStyle}}" bindtouchstart="onSkyTouchStart" bindtouchmove="onSkyTouchMove" bindtouchend="onSkyTouchEnd" bindtouchcancel="onSkyTouchEnd">
    <view class="sky-fallback"></view>
    <canvas wx:if="{{skyOn && !skyBroken}}" type="2d" id="card-sky" class="sky-canvas" bindrendererror="onSkyRenderError" binderror="onSkyRenderError"></canvas>
    <view class="sky-veil" wx:if="{{skyOn}}"></view>
    <view class="weather-copy">
    <view class="row-between">
      <view>
        <view class="place" wx:if="{{weatherPlace}}">{{weatherPlace}}</view>
        <view class="weather-chip" wx:if="{{weatherName}}">
          <weather-icon class="chip-icon" kind="{{weatherKind}}" tone="{{skyPhase}}" size="{{34}}" />
          <text class="weather-chip-text">{{weatherName}}</text>
        </view>
      </view>
      <view class="refresh" bindtap="refreshWeather">{{refreshing ? '刷新中' : '刷新'}}</view>
    </view>
    <view class="weather-hero" wx:if="{{weatherTemp}}" bindlongpress="holdTemp">
      <view class="temp-big">{{weatherTemp}}°</view>
    </view>
    <view class="title" wx:else bindlongpress="holdTemp">{{weatherText}}</view>
    <view class="muted" wx:if="{{tempMin !== '' && tempMax !== ''}}">{{tempMin}}° / {{tempMax}}°<text wx:if="{{feelsLike}}"> · 体感 {{feelsLike}}°</text></view>
    <scroll-view class="hour-scroll" scroll-x wx:if="{{hours.length}}">
      <view class="hour {{item.mark ? 'mark' : ''}}" wx:for="{{hours}}" wx:key="label">
        <view class="hour-label">{{item.label}}</view>
        <weather-icon class="hour-icon" kind="{{item.kind}}" tone="{{item.tone}}" size="{{32}}" />
        <view>{{item.temp}}°</view>
      </view>
    </scroll-view>
    <view class="hint-line" wx:for="{{hints}}" wx:for-index="hintIndex" wx:key="hintIndex">{{item}}</view>
    <view class="muted" wx:if="{{windText || humidityText}}">{{windText}}<text wx:if="{{windText && humidityText}}"> · </text><text wx:if="{{humidityText}}">湿度 {{humidityText}}%</text></view>
    <view class="muted" wx:if="{{clothing}}">{{clothing}}</view>
    <view class="care" wx:if="{{care}}">{{care}}</view>
    <view class="muted" wx:if="{{weatherHint}}">{{weatherHint}}</view>
    <picker wx:if="{{needCity}}" mode="region" value="{{region}}" bindchange="onCity">
      <view class="picker">{{cityName || '选择城市'}}</view>
    </picker>
    <view wx:if="{{needLocate}}" class="locate" bindtap="openPermissions">去设置里打开定位</view>
    <view class="sky-preview" wx:if="{{skyPreview}}">
      <view class="sky-choice {{skyPicked === item.key ? 'on' : ''}}" wx:for="{{skyChoices}}" wx:key="key" data-key="{{item.key}}" bindtap="pickSky">{{item.name}}</view>
      <view class="sky-choice {{skyNight ? 'on' : ''}}" bindtap="toggleNight">晚上</view>
      <view class="sky-back" bindtap="restoreSky">回到实际天气</view>
    </view>
    </view>
  </view>

  <view class="card note-card" wx:if="{{noteVisible}}">
    <view class="section-title" wx:if="{{noteText}}">{{noteFrom}}想对你说</view>
    <view class="section-title" wx:else>TA 还没有留话</view>
    <view class="note-body" wx:if="{{noteText}}">{{noteText}}</view>
    <view class="ask" bindtap="openNote">{{noteText ? '也留一句' : '留一句'}}</view>
  </view>

  <view class="card" wx:if="{{aiLines.length}}">
    <view class="section-title">今日建议</view>
    <view class="ai-badge">AI</view>
    <view class="ai-score" wx:if="{{aiScore}}">综合 {{aiScore}}</view>
    <view class="ai-line" wx:for="{{aiLines}}" wx:key="*this">{{item}}</view>
    <view class="muted note">仅供参考</view>
    <view class="ask" bindtap="openAsk">再问一句</view>
  </view>

  <view class="card remind" wx:if="{{reminder && !aiLines.length}}">
    <view class="mini-heart still"></view>
    <view>
      <view>{{reminder}}</view>
      <view class="muted">仅供生活参考，不是医疗判断</view>
    </view>
  </view>

  <view class="card next" bindtap="openCalendar">
    <view class="section-title">临近</view>
    <view>{{nextText}}</view>
  </view>

  <view style="height: {{tabClearance}}px;"></view>

  <view class="mask" wx:if="{{noteOpen}}" bindtap="closeNote">
    <view class="sheet" style="padding-bottom: {{tabClearance}}px;" catchtap="noop">
      <view class="section-title">留一句给 TA</view>
      <textarea class="field" placeholder-class="field-placeholder" maxlength="80" placeholder="今天也要好好照顾自己。" value="{{noteDraft}}" bindinput="onNoteDraft" />
      <view class="muted" wx:if="{{subscribeHint}}">这次提醒对方一次，没点允许也能在首页看到</view>
      <view class="btn" bindtap="sendNote">{{noteSending ? '送出中' : '送出'}}</view>
    </view>
  </view>
</scroll-view>
