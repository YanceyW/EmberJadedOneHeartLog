<view class="page">
  <view class="hello rise">
    <view class="mini-heart"></view>
    <view>
      <view class="title">{{hello}}</view>
      <view class="muted">今天也要好好照顾彼此</view>
    </view>
  </view>

  <view class="card weather rise d2">
    <view class="temp" wx:if="{{weatherTemp}}">{{weatherTemp}}°</view>
    <view class="title" wx:else>{{weatherText}}</view>
    <view wx:if="{{weatherName}}">{{weatherName}}</view>
    <view class="muted" wx:if="{{clothing}}">{{clothing}}</view>
    <view class="muted" wx:if="{{weatherHint}}">{{weatherHint}}</view>
    <button wx:if="{{needLocate}}" class="locate" bindtap="openPermissions">去设置里打开</button>
  </view>

  <view class="card remind rise d3" wx:if="{{reminder}}">
    <view class="mini-heart still"></view>
    <view>
      <view>{{reminder}}</view>
      <view class="muted">仅供生活参考，不是医疗判断</view>
    </view>
  </view>

  <view class="grid">
    <view class="entry" wx:for="{{soon}}" wx:key="*this" data-name="{{item}}" bindtap="openSoon">
      <view>{{item}}</view>
      <view class="muted">施工中</view>
    </view>
  </view>
  <tab-bar current="home" />
</view>
