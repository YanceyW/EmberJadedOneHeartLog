:host {
  display: block;
  width: 100%;
  height: 100%;
}

.page {
  width: 100%;
  height: 100%;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 16rpx 32rpx 0;
}

::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.card {
  position: relative;
  z-index: 1;
  background: #fffaf8;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(227, 154, 168, 0.12);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #5c463f;
}

.muted {
  color: #a08b84;
  font-size: 26rpx;
  line-height: 1.5;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #5c463f;
  margin-bottom: 8rpx;
}

.place {
  color: #8a3d48;
  margin-bottom: 8rpx;
}

.weather-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  padding: 6rpx 20rpx 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.26);
}

.weather-chip-text {
  font-size: 26rpx;
  line-height: 1.2;
  color: #fff;
  white-space: nowrap;
}

.weather-card.no-sky .weather-chip {
  background: #fff7f4;
  border-color: #f1dcd6;
}

.weather-card.no-sky .weather-chip-text {
  color: #5c463f;
}

.weather-card.no-sky .chip-icon,
.weather-card.no-sky .hour-icon {
  filter: brightness(0.4) saturate(0.6);
}

.weather-card {
  overflow: hidden;
  background: #fffaf8;
}

.weather-card.sky-on {
  background: #3c5265;
}

.sky-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 0;
  border-radius: inherit;
}

.sky-fallback {
  display: none;
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  border-radius: inherit;
  background: linear-gradient(180deg, var(--sky-a, #3c5265) 0%, var(--sky-b, #6d8496) 56%, var(--sky-c, #9fadb8) 100%);
}

.sky-fallback::before {
  content: "";
  position: absolute;
  left: -6%;
  top: 4%;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 240, 205, 0.5), rgba(255, 240, 205, 0) 70%);
}

.sky-fallback::after {
  content: "";
  position: absolute;
  left: -10%;
  right: -10%;
  top: 34%;
  height: 130rpx;
  background:
    radial-gradient(ellipse 34% 100% at 24% 60%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 72%),
    radial-gradient(ellipse 30% 90% at 68% 54%, rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0) 74%);
}

.sky-broken .sky-canvas {
  display: none;
}

.sky-broken .sky-fallback {
  display: block;
}

.sky-veil {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(12, 18, 30, 0.05) 0%, rgba(13, 19, 30, 0.24) 32%, rgba(12, 18, 29, 0.5) 72%, rgba(11, 16, 26, 0.62) 92%, rgba(10, 15, 25, 0.3) 100%);
}

.weather-card.is-dark .sky-veil {
  background: linear-gradient(180deg, rgba(8, 12, 22, 0) 0%, rgba(8, 12, 22, 0.12) 32%, rgba(8, 12, 22, 0.38) 72%, rgba(6, 9, 16, 0.5) 92%, rgba(6, 9, 16, 0.22) 100%);
}

.weather-copy {
  position: relative;
  z-index: 2;
}

.weather-card.sky-on .title,
.weather-card.sky-on .temp-big,
.weather-card.sky-on .hour,
.weather-card.sky-on .hint-line,
.weather-card.sky-on .care {
  color: #fff;
  text-shadow: 0 2rpx 10rpx rgba(12, 18, 30, 0.45);
}

.weather-card.sky-on .muted {
  color: rgba(255, 255, 255, 0.78);
  text-shadow: 0 2rpx 8rpx rgba(12, 18, 30, 0.4);
}

.weather-card.sky-on .place {
  color: #ffe4e9;
  text-shadow: 0 2rpx 10rpx rgba(12, 18, 30, 0.45);
}

.weather-card.sky-on .refresh {
  color: #fff;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
}

.weather-card.sky-on .hour.mark {
  background: rgba(255, 255, 255, 0.2);
}

.weather-card.sky-on .hour-label {
  color: rgba(255, 255, 255, 0.66);
}

.weather-card.sky-on .picker {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
}

.weather-card.sky-on .sky-choice {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
}

.weather-card.sky-on .sky-choice.on {
  background: #e9899a;
}

.weather-card.sky-on .sky-back {
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  color: #fff;
}

.weather-card .place { margin-bottom: 0; }
.weather-hero {
  margin-top: 10rpx;
}
.temp-big {
  font-size: 96rpx;
  line-height: 1;
  font-weight: 600;
  color: #5c463f;
}
.hour-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}
.hour {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 108rpx;
  margin-right: 8rpx;
  padding: 12rpx 0;
  border-radius: 20rpx;
  color: #5c463f;
  font-size: 24rpx;
}
.hour.mark { background: rgba(233, 137, 154, 0.16); }
.hour-label { color: #a08b84; font-size: 22rpx; }
.hour-icon { margin: 8rpx 0; }
.hint-line {
  margin-top: 16rpx;
  line-height: 1.6;
  color: #5c463f;
}

.sky-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.sky-choice,
.sky-back {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #8a3d48;
  font-size: 24rpx;
}

.sky-choice.on {
  background: #e9899a;
  color: #fff;
}

.sky-back {
  background: transparent;
  border: 2rpx solid #e9899a;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.picker {
  margin-top: 16rpx;
  background: #fff7f4;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
}

.refresh {
  color: #e9899a;
  font-size: 26rpx;
  flex-shrink: 0;
}

.hello {
  position: relative;
  z-index: 1;
  background: #fffaf8;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(227, 154, 168, 0.12);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.mini-heart {
  width: 28rpx;
  height: 28rpx;
  background: #e9899a;
  transform: rotate(-45deg);
  position: relative;
  flex-shrink: 0;
  animation: heart-pop 0.35s ease;
}

.mini-heart.still {
  animation: none;
  margin-top: 8rpx;
}

.mini-heart::before,
.mini-heart::after {
  content: "";
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  background: #e9899a;
  border-radius: 50%;
}

.mini-heart::before {
  top: -14rpx;
  left: 0;
}

.mini-heart::after {
  left: 14rpx;
  top: 0;
}

.weather .temp {
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.1;
  color: #5c463f;
}

.ai-badge {
  display: inline-block;
  background: #5c463f;
  color: #fff;
  font-size: 22rpx;
  line-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
}

.ai-score {
  margin-top: 12rpx;
  color: #8a3d48;
}

.ai-line {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  background: #fff3c4;
  border-radius: 12rpx;
  line-height: 1.6;
}

.note {
  margin-top: 16rpx;
}

.ask {
  margin-top: 16rpx;
  border: 2rpx solid #e9899a;
  color: #8a3d48;
  border-radius: 999rpx;
  text-align: center;
  line-height: 72rpx;
  font-weight: 600;
}

.remind {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.entry {
  width: calc(50% - 8rpx);
  background: #fffaf8;
  border-radius: 28rpx;
  padding: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 28rpx rgba(227, 154, 168, 0.12);
  transition: transform 0.2s ease;
}

.locate {
  margin-top: 20rpx;
  background: #e9899a;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.locate::after {
  border: none;
}

.note-body {
  margin-top: 12rpx;
  font-size: 34rpx;
  line-height: 1.6;
  color: #5c463f;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(92, 70, 63, 0.28);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fffaf8;
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 28rpx 0;
  box-sizing: border-box;
}

.field-placeholder {
  color: #a08b84;
}

.field {
  width: 100%;
  height: 160rpx;
  margin-top: 16rpx;
  background: #fff7f4;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  color: #5c463f;
  box-sizing: border-box;
}

.btn {
  margin-top: 20rpx;
  background: #e9899a;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  text-align: center;
}
