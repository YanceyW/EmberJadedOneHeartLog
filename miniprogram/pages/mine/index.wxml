<view class="page">
  <view class="card">
    <view class="label">昵称</view>
    <input value="{{nickName}}" placeholder="怎么称呼你" bindinput="onNick" />
    <view class="label">性别</view>
    <view class="row">
      <view class="chip {{gender === 'female' ? 'on' : ''}}" data-gender="female" bindtap="onGender">女</view>
      <view class="chip {{gender === 'male' ? 'on' : ''}}" data-gender="male" bindtap="onGender">男</view>
    </view>
    <view class="muted" wx:if="{{!gender}}">还没选性别时不显示经期</view>
    <block wx:if="{{showOwnCycle}}">
      <view class="label">周期长度（天）</view>
      <input type="number" value="{{cycleLength}}" bindinput="onCycle" />
      <view class="label">经期长度（天）</view>
      <input type="number" value="{{periodLength}}" bindinput="onPeriod" />
    </block>
    <block wx:if="{{showPartnerCycle}}">
      <view class="label">对象的周期长度（天）</view>
      <input type="number" value="{{partnerCycleLength}}" bindinput="onPartnerCycle" />
      <view class="label">对象的经期长度（天）</view>
      <input type="number" value="{{partnerPeriodLength}}" bindinput="onPartnerPeriod" />
    </block>
    <view class="btn save" bindtap="saveProfile">保存资料</view>
  </view>

  <view class="card">
    <view class="label">对象</view>
    <view>{{partnerText}}</view>
    <view class="btn plain" wx:if="{{chosenOpenid}}" bindtap="clearPartner">取消选择</view>
    <view class="person" wx:for="{{people}}" wx:key="openid">
      <view>
        <view>{{item.nickName || '未命名'}}</view>
        <view class="muted">{{item.chosenMe ? '对方已选择你' : ''}}</view>
      </view>
      <view class="chip {{chosenOpenid === item.openid ? 'on' : ''}}" data-openid="{{item.openid}}" bindtap="choose">确认为对象</view>
    </view>
    <view class="muted" wx:if="{{!people.length}}">还没有其他人打开过这个小程序</view>
  </view>
  <view class="card setting" bindtap="openSettings">
    <view>设置</view>
    <view class="muted">权限</view>
  </view>
  <tab-bar current="mine" />
</view>
