<view class="page" style="padding-bottom: {{tabClearance}}px;">
  <view class="card person">
    <view class="mini-heart"></view>
    <view class="who">
      <view class="name">{{nickName}}</view>
      <view class="sub">{{partnerText}}</view>
    </view>
  </view>
  <view class="card item" bindtap="openProfile">
    <view class="name">编辑资料</view>
    <view class="sub">昵称、性别、对象</view>
  </view>
  <view class="card item" bindtap="openPermissions">
    <view class="name">权限</view>
    <view class="sub">位置权限</view>
  </view>
  <view class="group">以后</view>
  <view class="card item" wx:for="{{later}}" wx:key="*this" data-name="{{item}}" bindtap="openSoon">
    <view class="name">{{item}}</view>
    <view class="sub">施工中</view>
  </view>
</view>
