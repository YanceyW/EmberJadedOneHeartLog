<scroll-view class="page" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="head">
    <view class="avatar">{{initial}}</view>
    <view class="who">
      <view class="name">{{nickName}}</view>
      <view class="sub">{{partnerText}}</view>
    </view>
    <view class="head-tools">
      <view class="edit" bindtap="openProfile">编辑</view>
      <view class="edit" bindtap="openSettings">设置</view>
    </view>
  </view>

  <view class="seg-wrap">
    <view class="seg">
      <view class="seg-item {{seg === item.key ? 'on' : ''}}" wx:for="{{segs}}" wx:key="key" data-key="{{item.key}}" bindtap="pickSeg">{{item.name}}</view>
    </view>
  </view>

  <view class="seg-body" wx:if="{{seg !== 'capsule'}}">
    <view class="mini-heart"></view>
    <view class="muted">{{segHint}}</view>
  </view>

  <view class="cap-wrap" wx:if="{{seg === 'capsule'}}">
    <view class="cap-add" bindtap="openCapsuleNew">封一个时光胶囊</view>
    <view class="cap-item" wx:for="{{capsules}}" wx:key="id" data-id="{{item.id}}" bindtap="openCapsuleItem">
      <view class="cap-line">
        <view class="cap-title">{{item.title}}</view>
        <view class="cap-state {{item.due ? 'due' : ''}}">{{item.due ? '可以打开' : '还有 ' + item.daysLeft + ' 天'}}</view>
      </view>
      <view class="cap-sub">{{item.openAt}} 开启{{item.mine ? '' : ' · TA 封的'}}</view>
    </view>
    <view class="muted cap-empty" wx:if="{{!capsules.length}}">还没有胶囊。写一段话，定个以后的日子再打开。</view>
  </view>

  <view style="height: {{tabClearance}}px;"></view>

  <view class="mask" wx:if="{{capOpen}}" bindtap="closeCap">
    <view class="sheet" style="padding-bottom: {{tabClearance}}px;" catchtap="noop">
      <block wx:if="{{capView}}">
        <view class="sheet-title">{{capView.title}}</view>
        <view class="cap-content">{{capView.content}}</view>
        <view class="btn" bindtap="closeCap">收好</view>
      </block>
      <block wx:elif="{{cf}}">
        <view class="sheet-title">封一个时光胶囊</view>
        <input class="cap-input" value="{{cf.title}}" placeholder="给这段文字起个名字" maxlength="30" bindinput="onCapTitle" />
        <textarea class="cap-textarea" value="{{cf.content}}" placeholder="想对以后的你们说什么" maxlength="1000" bindinput="onCapContent" />
        <view class="cap-label">开启日期</view>
        <picker mode="date" value="{{cf.openAt}}" bindchange="onCapDate">
          <view class="cap-picker">{{cf.openAt}}</view>
        </picker>
        <view class="cap-label">谁能看</view>
        <view class="cap-row">
          <view class="cap-chip {{cf.visibility === 'both' ? 'on' : ''}}" data-value="both" bindtap="onCapVisibility">双方都能看</view>
          <view class="cap-chip {{cf.visibility === 'self' ? 'on' : ''}}" data-value="self" bindtap="onCapVisibility">只有我自己</view>
        </view>
        <remind-picker value="{{cf.remind}}" target-date="{{capRemindDate}}" hint="到日子会提醒你们回来打开" bind:change="onCapRemind" />
        <view class="btn cap-save" bindtap="saveCapsule">封起来</view>
      </block>
    </view>
  </view>
</scroll-view>
