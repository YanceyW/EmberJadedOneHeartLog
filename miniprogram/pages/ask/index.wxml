<view class="ask-page">
  <view class="head">
    <view class="title">聊天</view>
    <view class="tool-wrap">
      <view class="tool-btn" bindtap="openSettings" hover-class="tool-btn-on">
        <view class="glyph">
          <view class="memo">
            <view class="line"></view>
            <view class="line short"></view>
          </view>
        </view>
      </view>
      <view class="tool-btn" bindtap="startDelete" hover-class="tool-btn-on">
        <view class="glyph">
          <view wx:if="{{selecting}}" class="close"></view>
          <view wx:else class="trash">
            <view class="lid"></view>
            <view class="can"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="talk" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollInto}}" upper-threshold="80" bindscrolltoupper="loadOlder">
    <view class="talk-pad"></view>
    <view class="day" wx:if="{{hasMore}}">继续向上查看更早的记录</view>
    <view wx:for="{{messages}}" wx:key="id" id="m-{{item.id}}">
      <view class="day" wx:if="{{item.showDay}}">{{item.dayText}}</view>
      <view class="pair {{selecting && picked[item.id] ? 'on' : ''}}" data-id="{{item.id}}" catchtap="onPair">
        <view class="check" wx:if="{{selecting}}">{{picked[item.id] ? '✓' : ''}}</view>
        <view class="stack">
          <view class="bubble user">{{item.question}}</view>
          <view class="bubble ai">
            <view class="ai-badge">AI</view>
            <view>{{item.shown}}</view>
          </view>
          <view class="proposal" wx:if="{{item.proposal && !item.proposalDone}}">
            <view class="proposal-head">要记下这个安排吗</view>
            <view class="proposal-title">{{item.proposal.title}}</view>
            <view class="proposal-date">{{item.proposal.date}}<text wx:if="{{item.proposal.note}}"> · {{item.proposal.note}}</text></view>
            <view class="proposal-row">
              <view class="proposal-btn ghost" data-index="{{index}}" bindtap="dismissProposal">不用</view>
              <view class="proposal-btn" data-index="{{index}}" bindtap="confirmProposal">记下</view>
            </view>
          </view>
          <view class="proposal-done" wx:if="{{item.proposal && item.proposalDone}}">{{item.proposalSkipped ? '没有记' : '已记入日程'}}</view>
        </view>
      </view>
    </view>
    <view id="end"></view>
  </scroll-view>

  <view class="footer" style="padding-bottom: {{tabClearance}}px;">
    <view wx:if="{{selecting}}" class="confirm" bindtap="confirmDelete">删除所选 {{pickedCount}}</view>
    <view wx:else class="composer">
      <input class="ask-input" value="{{question}}" placeholder="想问今天怎么样" confirm-type="send" bindinput="onQuestion" bindconfirm="send" />
      <view class="send-btn {{writing ? 'off' : ''}}" bindtap="send" hover-class="send-btn-on">
        <view class="send-icon"></view>
      </view>
    </view>
  </view>

  <view class="mask" wx:if="{{settingsOpen}}" bindtap="closeSettings">
    <view class="sheet" style="padding-bottom: {{tabClearance}}px;" catchtap="noop">
      <view class="detail-head">
        <view class="section-title">记忆</view>
        <view class="tool danger" wx:if="{{memoryText}}" bindtap="clearMemory">清空</view>
      </view>
      <view class="muted tip">聊天里说「记住」「记一下」时，会写进这里。AI 回答时会参考这段话。</view>
      <view class="label">要记住的事</view>
      <textarea class="memo-box" value="{{memoryText}}" maxlength="400" placeholder="还没有记住的事，比如口味、作息、不想被提醒的事" bindinput="onMemory" />
      <view class="count muted">{{memoryText.length || 0}} / 400</view>
      <view class="btn" bindtap="saveSettings">保存记忆</view>
    </view>
  </view>
</view>
