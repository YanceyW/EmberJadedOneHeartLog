:host {
  display: block;
  width: 100%;
  height: 100%;
}

/* 与其余 tab 面板一样，挂在主页里，共用系统导航和底栏 */
.ask-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: #fff7f4;
  padding: 16rpx 32rpx 0;
  overflow: hidden;
}

/* 顶栏对齐日历：居中标题 + 右侧工具 */
.head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  background: #fff7f4;
  z-index: 2;
}

.head .title {
  font-size: 36rpx;
  font-weight: 600;
  color: #5c463f;
}

.tool-wrap {
  position: absolute;
  right: 0;
  top: 0;
  z-index: 16;
  display: flex;
  align-items: center;
}

.tool-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-btn-on {
  opacity: 0.55;
}

/* 外框固定 36×36，两枚图标同一中线；颜色线条跟日历筛选一致 */
.glyph {
  width: 36rpx;
  height: 36rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.memo {
  width: 28rpx;
  height: 34rpx;
  border: 4rpx solid #e9899a;
  border-radius: 6rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  padding: 0 4rpx;
}

.memo .line {
  width: 100%;
  height: 4rpx;
  border-radius: 4rpx;
  background: #e9899a;
}

.memo .line.short {
  width: 70%;
}

.trash {
  width: 28rpx;
  height: 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-sizing: border-box;
}

.trash .lid {
  width: 28rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #e9899a;
  position: relative;
}

.trash .lid::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -6rpx;
  width: 12rpx;
  height: 4rpx;
  margin-left: -6rpx;
  border-radius: 4rpx;
  background: #e9899a;
}

.trash .can {
  width: 22rpx;
  height: 20rpx;
  border: 4rpx solid #e9899a;
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
  box-sizing: border-box;
}

.close {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.close::before,
.close::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 4rpx;
  margin-left: -14rpx;
  margin-top: -2rpx;
  background: #e9899a;
  border-radius: 4rpx;
}

.close::before {
  transform: rotate(45deg);
}

.close::after {
  transform: rotate(-45deg);
}

.talk {
  flex: 1;
  height: 0;
  width: 100%;
  box-sizing: border-box;
}

.talk-pad {
  height: 8rpx;
}

.day {
  margin: 8rpx 0 24rpx;
  padding: 4rpx 0;
  text-align: center;
  color: #a08b84;
  font-size: 24rpx;
  line-height: 1.5;
}

.pair {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 0 0 12rpx;
}

.pair.on .check {
  background: #e9899a;
  color: #fff;
}

.stack {
  flex: 1;
  min-width: 0;
}

.check {
  width: 40rpx;
  height: 40rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  border: 2rpx solid #e9899a;
  text-align: center;
  line-height: 40rpx;
  color: transparent;
  flex-shrink: 0;
}

.bubble {
  max-width: 86%;
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  line-height: 1.6;
}

.bubble.user {
  margin-left: auto;
  background: #f8d5dc;
  color: #5c463f;
}

.bubble.ai {
  background: #fff3c4;
  color: #5c463f;
}

.ai-badge {
  display: inline-block;
  margin-bottom: 8rpx;
  background: #5c463f;
  color: #fff;
  font-size: 22rpx;
  line-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
}

.footer {
  flex-shrink: 0;
  padding: 8rpx 0 0;
  box-sizing: border-box;
}

.composer {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ask-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  margin-top: 0;
  box-sizing: border-box;
  background: #fffaf8;
  border-radius: 999rpx;
  color: #5c463f;
  font-size: 28rpx;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #e9899a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn-on {
  opacity: 0.75;
}

.send-btn.off {
  opacity: 0.45;
}

.send-icon {
  width: 0;
  height: 0;
  margin-left: 4rpx;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-left: 20rpx solid #fff;
}

.confirm {
  height: 80rpx;
  line-height: 80rpx;
  background: #e9899a;
  color: #fff;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(92, 70, 63, 0.28);
  display: flex;
  align-items: flex-end;
  z-index: 80;
  animation: maskin 0.25s ease;
}

.sheet {
  width: 100%;
  background: #fffaf8;
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 28rpx 0;
  box-sizing: border-box;
  max-height: 80vh;
  overflow: auto;
  position: relative;
  z-index: 81;
  animation: slideup 0.32s ease;
}

.detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #5c463f;
  margin-bottom: 8rpx;
}

.tool {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f8d5dc;
  color: #8a3d48;
  flex-shrink: 0;
  font-size: 26rpx;
}

.tool.danger {
  background: #e9899a;
  color: #fff;
}

.tip {
  margin: 4rpx 0 8rpx;
  line-height: 1.5;
}

.label {
  margin-top: 16rpx;
  color: #a08b84;
  font-size: 26rpx;
}

.memo-box {
  width: 100%;
  min-height: 280rpx;
  margin-top: 12rpx;
  background: #fff7f4;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  color: #5c463f;
  font-size: 30rpx;
  line-height: 1.6;
}

.count {
  margin-top: 8rpx;
  text-align: right;
}

.muted {
  color: #a08b84;
  font-size: 26rpx;
}

.btn {
  margin-top: 16rpx;
  background: #e9899a;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  text-align: center;
}

.btn:active {
  transform: scale(0.97);
}

@keyframes maskin {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideup {
  from { transform: translateY(48rpx); }
  to { transform: translateY(0); }
}

.proposal {
  margin: -4rpx 0 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #fffaf8;
  border: 2rpx dashed #e9899a;
}

.proposal-head {
  font-size: 24rpx;
  color: #a08b84;
}

.proposal-title {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #5c463f;
}

.proposal-date {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: #8a3d48;
}

.proposal-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.proposal-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  background: #e9899a;
  color: #fff;
  font-size: 28rpx;
}

.proposal-btn.ghost {
  background: #f8d5dc;
  color: #8a3d48;
}

.proposal-done {
  margin: -4rpx 0 16rpx;
  font-size: 24rpx;
  color: #a08b84;
}