.page {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 600;
  color: #5c463f;
}

.head-btn {
  padding: 6rpx 26rpx;
  border-radius: 999rpx;
  border: 2rpx solid #f0cdd4;
  background: #fffaf8;
  color: #8a3d48;
  font-size: 26rpx;
  line-height: 44rpx;
}

.week-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #fffaf8;
  border-radius: 20rpx;
  padding: 16rpx 22rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(227, 154, 168, 0.1);
}

.week-state {
  font-size: 26rpx;
  font-weight: 600;
  color: #8a3d48;
  background: #f8d5dc;
  border-radius: 999rpx;
  padding: 2rpx 18rpx;
}

.week-state.is-home {
  color: #ffffff;
  background: #e9899a;
}

.week-cycle {
  flex: 1;
  font-size: 24rpx;
  color: #a08b84;
}

.week-more {
  font-size: 24rpx;
  color: #a08b84;
}

.week-banner {
  background: linear-gradient(135deg, #ffe6ec, #fff2ea);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  color: #8a3d48;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.holiday-banner {
  background: linear-gradient(135deg, #ffe0e6, #fff1e8);
  border-radius: 24rpx;
  padding: 18rpx 24rpx;
  color: #b8566a;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

/* ---------- 整周表格 ---------- */
.board {
  transition: opacity 0.2s ease;
}

.board.is-faded {
  opacity: 0.45;
}

.grid-row {
  display: flex;
  align-items: stretch;
  gap: 4rpx;
  margin-bottom: 6rpx;
}

.grid-row.is-head {
  margin-bottom: 10rpx;
}

.grid-time {
  width: 70rpx;
  flex: none;
  padding-top: 12rpx;
  text-align: right;
}

.grid-time.is-right {
  text-align: left;
  padding-left: 4rpx;
}

.grid-clock {
  font-size: 22rpx;
  font-weight: 600;
  color: #8a3d48;
  line-height: 1.2;
}

.grid-period {
  font-size: 18rpx;
  color: #a08b84;
  line-height: 1.3;
  margin-top: 2rpx;
}

.grid-time.is-right .grid-clock {
  font-size: 20rpx;
}

.grid-time.is-right .grid-period {
  font-size: 16rpx;
}

.grid-cells {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: stretch;
  gap: 4rpx;
}

.cell-head {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 8rpx 2rpx;
  border-radius: 12rpx;
  position: relative;
}

.cell-head.is-weekend {
  background: #fdf0f3;
}

.cell-head.is-today {
  background: #e9899a;
}

.head-char {
  font-size: 22rpx;
  font-weight: 600;
  color: #5c463f;
  line-height: 1.3;
}

.head-date {
  font-size: 18rpx;
  color: #a08b84;
  line-height: 1.3;
}

.cell-head.is-weekend .head-char {
  color: #8a3d48;
}

.cell-head.is-today .head-char,
.cell-head.is-today .head-date {
  color: #ffffff;
}

.head-flag {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  min-width: 18rpx;
  height: 18rpx;
  line-height: 18rpx;
  border-radius: 5rpx;
  font-size: 14rpx;
  text-align: center;
  color: #ffffff;
  background: #e9899a;
}

.head-flag.rest {
  background: #e9899a;
}

.head-flag.work {
  background: #9aa7b8;
}

.cell-head.is-today .head-flag {
  background: #ffffff;
  color: #e9899a;
}

.grid-group {
  font-size: 20rpx;
  color: #a08b84;
  padding: 10rpx 0 6rpx 74rpx;
}

.cell {
  flex: 1;
  min-width: 0;
  min-height: 64rpx;
  padding: 6rpx 4rpx;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.cell.is-empty {
  background: #fff7f4;
  border: 1rpx dashed #ecd3d8;
}

.cell.is-off {
  background: transparent;
}

.cell-text {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.25;
  text-align: center;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.gap-before {
  margin-left: 4rpx;
}

/* ---------- 课文配色 ---------- */
.tone-0 {
  background: #fce4e9;
  color: #a3405a;
}

.tone-1 {
  background: #fce8dc;
  color: #96522a;
}

.tone-2 {
  background: #faf0d6;
  color: #856318;
}

.tone-3 {
  background: #e9f0dc;
  color: #57682f;
}

.tone-4 {
  background: #dff0e8;
  color: #356b52;
}

.tone-5 {
  background: #dcecee;
  color: #2f6469;
}

.tone-6 {
  background: #e3ecf7;
  color: #3a5c80;
}

.tone-7 {
  background: #ece6f4;
  color: #5f4a7c;
}

.tone-8 {
  background: #f5e4f0;
  color: #7a3f66;
}

.tone-9 {
  background: #f5e5e1;
  color: #854f42;
}

.tone-10 {
  background: #f2ece1;
  color: #6b5943;
}

.tone-11 {
  background: #e8eaef;
  color: #4c5568;
}

.empty-hint {
  font-size: 24rpx;
  color: #b08b91;
  background: #fff7f4;
  border-radius: 18rpx;
  padding: 14rpx 20rpx;
  margin-top: 20rpx;
}

.tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
}

.tip-dim {
  color: #b08b91;
}

.tip-link {
  color: #8a3d48;
  font-weight: 600;
  text-decoration: underline;
  padding: 0 4rpx;
}

.empty {
  text-align: center;
  padding: 140rpx 20rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #5c463f;
  margin-bottom: 10rpx;
}

.empty .btn {
  margin-top: 36rpx;
}

/* ---------- 填格子的弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(92, 70, 63, 0.28);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fffaf8;
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #5c463f;
  margin-bottom: 8rpx;
}

.field {
  background: #ffffff;
  border: 2rpx solid #f0cdd4;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 30rpx;
  color: #5c463f;
}

.field-placeholder {
  color: #bda7a1;
}

.tone-range {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}

.range-item {
  flex: 1;
  text-align: center;
  line-height: 56rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #8a3d48;
  background: #fff7f4;
  border: 2rpx solid #f0cdd4;
  box-sizing: border-box;
}

.range-item.on {
  background: #e9899a;
  border-color: #e9899a;
  color: #ffffff;
  font-weight: 600;
}

.tones {
  display: flex;
  gap: 8rpx;
  margin-top: 18rpx;
}

.tone-dot {
  flex: 1;
  height: 48rpx;
  border-radius: 12rpx;
  position: relative;
}

.tone-check {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border: 3rpx solid #5c463f;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.sheet-hint {
  font-size: 22rpx;
  line-height: 1.5;
  margin-top: 14rpx;
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.sheet-btn {
  flex: 1;
  text-align: center;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #e9899a;
  color: #ffffff;
  font-weight: 600;
}

.sheet-btn.ghost {
  background: #fff7f4;
  color: #8a3d48;
  border: 2rpx solid #f0cdd4;
}

.sheet-btn.danger {
  background: #fff7f4;
  color: #b8566a;
  border: 2rpx solid #f6d4da;
}
